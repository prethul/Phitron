string = """Data Science is a field that focuses on collecting, analyzing, and interpreting data to make better decisions.
In today’s digital world, a huge amount of data is generated every day from sources like social media,
online shopping, and banking."""
words = string.split()
count ={}

for word in words:
    count[word] = count.get(word,0) + 1
print(count) 

